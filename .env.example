# ==============================================================================
# eToro Tracker 環境變數設定範例檔 (.env)
# 請複製此檔案為 .env 並填入實際數值
# ==============================================================================

# 目標追蹤 eToro 用戶名 (預設 miulatw)
TARGET_USERNAME=miulatw

# Gemini 1.5 Flash API Key (用於生成每日調倉總結)
# 申請網址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Pages 或線上儀表板網址 (用於推播訊息中的點擊連結)
PAGES_URL=https://your-github-username.github.io/etoro/

# ------------------------------------------------------------------------------
# 通知管道設定 (至少設定一種，可同時啟用多種)
# ------------------------------------------------------------------------------

# 1. Telegram Bot (推薦)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. LINE Notify (注意: LINE 官方預計陸續調整服務)
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# 3. Email (SMTP) 通知
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
NOTIFICATION_EMAIL=recipient@example.com

# 4. Discord Webhook (選填)
DISCORD_WEBHOOK_URL=
